<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOCUSLOCK" android:textColor="@color/orange" android:textSize="22sp" android:letterSpacing="0.15" android:fontFamily="monospace" android:textStyle="bold"/>
                <TextView android:id="@+id/statusLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● FOCUSLOCK INACTIVO" android:textColor="@color/text_secondary" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="2dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activar bloqueo" android:textColor="@color/text_primary" android:textSize="15sp"/>
                        <TextView android:id="@+id/serviceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Verificando..." android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/masterToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/orange" app:trackTint="@color/surface_variant"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEnableService" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. ACTIVAR ACCESIBILIDAD" android:textColor="@color/orange" android:textSize="11sp" app:strokeColor="@color/orange" android:layout_marginTop="10dp" android:visibility="gone" android:fontFamily="monospace"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEnableUsage" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. ACTIVAR PERMISO DE USO (XIAOMI)" android:textColor="@color/orange" android:textSize="11sp" app:strokeColor="@color/orange" android:layout_marginTop="6dp" android:visibility="gone" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- TIMER -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:layout_marginTop="1dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DURACIÓN DE SESIÓN" android:textColor="@color/text_tertiary" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTimer25" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="25 min" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="4dp" app:strokeColor="@color/divider"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTimer45" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="45 min" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="4dp" app:strokeColor="@color/divider"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTimer90" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="90 min" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginEnd="4dp" app:strokeColor="@color/divider"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNoTimer" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="∞" android:textSize="14sp" android:fontFamily="monospace" app:strokeColor="@color/divider"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" app:hintTextColor="@color/text_tertiary" android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/customTimerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Minutos personalizados (ej: 120)" android:textSize="13sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/timerDisplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sin límite de tiempo" android:textSize="13sp" android:textColor="@color/text_secondary" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- NUCLEAR -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/surface" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:layout_marginTop="1dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠ MODO NUCLEAR" android:textColor="@color/red" android:textSize="13sp" android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bloquea absolutamente todo" android:textColor="@color/text_tertiary" android:textSize="12sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/nuclearToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/red" app:trackTint="@color/surface_variant"/>
            </LinearLayout>

            <!-- MODE -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:layout_marginTop="1dp">
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBlacklist" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="LISTA NEGRA" android:textSize="11sp" android:fontFamily="monospace"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnWhitelist" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="LISTA BLANCA" android:textSize="11sp" android:fontFamily="monospace"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/modeDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="@color/text_secondary" android:fontFamily="monospace" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- HOLD TO DEACTIVATE -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:layout_marginTop="1dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/holdDeactivateBtn" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="MANTENER PARA DESACTIVAR" android:textColor="@color/red" android:textSize="12sp" android:fontFamily="monospace" android:visibility="gone" app:strokeColor="@color/red"/>
                <ProgressBar android:id="@+id/holdProgressBar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:progress="0" android:max="100" android:visibility="gone" android:progressTint="@color/red"/>
            </LinearLayout>

            <!-- APP LIST — RecyclerView con nestedScrollingEnabled=false para que scrollee con el padre -->
            <LinearLayout android:id="@+id/appListSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="6dp">
                    <TextView android:id="@+id/appCountLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="CARGANDO..." android:textColor="@color/text_tertiary" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/selectedCountLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/orange" android:textSize="10sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="8dp" app:hintTextColor="@color/text_tertiary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buscar app..." android:textSize="14sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>
                <ProgressBar android:id="@+id/loadingIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="32dp" android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
